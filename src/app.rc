#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
#include "pdf/resource.h"
#include "land_plans_editor_resource.h"

IDI_BIC ICON "volleyball.ico"

// Оба PDF-диалога хранятся рядом с кодом обработки и входят в один ресурсный модуль.
#include "pdf/file_report.rc"
#include "land_plans_editor.rc"

// Внутренней рамки нет: «Закрыть» занимает всю ширину между боковыми отступами.
IDD_PLACEMENT DIALOGEX 0, 0, 112, 102
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Размещение"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "1/4", IDC_PLACEMENT_TOP_LEFT, "BUTTON", BS_RADIOBUTTON | BS_PUSHLIKE | WS_GROUP | WS_TABSTOP, 6, 6, 48, 18
    CONTROL "1/4", IDC_PLACEMENT_TOP_RIGHT, "BUTTON", BS_RADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 58, 6, 48, 18
    CONTROL "1/4", IDC_PLACEMENT_BOTTOM_LEFT, "BUTTON", BS_RADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 6, 28, 48, 18
    CONTROL "1/2", IDC_PLACEMENT_LEFT_HALF, "BUTTON", BS_RADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 6, 50, 30, 18
    CONTROL "Центр", IDC_PLACEMENT_CENTER, "BUTTON", BS_RADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 40, 50, 32, 18
    CONTROL "1/2", IDC_PLACEMENT_RIGHT_HALF, "BUTTON", BS_RADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 76, 50, 30, 18
    DEFPUSHBUTTON "Закрыть", IDCANCEL, 6, 76, 100, 20, WS_GROUP
END
