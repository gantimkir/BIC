{
  "version": 4,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "BIC Windows Debug",
      "generator": "Ninja",
      "binaryDir": "$env{BIC_BUILD_ROOT}/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-release",
      "displayName": "BIC Windows Release (portable)",
      "inherits": "windows-debug",
      "binaryDir": "$env{BIC_BUILD_ROOT}/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BIC_REQUIRE_GHOSTSCRIPT": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" }
  ]
}
