{
    "version":  "2.0.0",
    "tasks":  [
                  {
                      "label":  "BIC: build and check",
                      "type":  "process",
                      "command":  "powershell.exe",
                      "args":  [
                                   "-NoProfile",
                                   "-ExecutionPolicy",
                                   "Bypass",
                                   "-File",
                                   "${workspaceFolder}/build.ps1",
                                   "-BuildRoot",
                                   "${config:bic.buildRoot}"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}"
                                  },
                      "group":  {
                                    "kind":  "build",
                                    "isDefault":  true
                                },
                      "problemMatcher":  "$msCompile"
                  }
              ]
}
